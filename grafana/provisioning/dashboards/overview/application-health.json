      "title": "EC2 - Peor CPU",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch-main"
          },
          "refId": "A",
          "region": "default",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "namespace": "",
          "metricName": "",
          "statistic": "Average",
          "period": "300",
          "id": "e1",
          "expression": "MAX(SEARCH('{AWS/EC2,InstanceId} MetricName=\"CPUUtilization\"', 'Average', 300))",
          "label": "Peor CPU"
        }
      ]
    },
