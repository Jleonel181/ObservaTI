# ============================================================
# ObservaTI - Variables de Entorno
# ============================================================
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- Grafana ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GF_SERVER_ROOT_URL=http://localhost:3000
GF_SERVER_DOMAIN=localhost

# --- AWS CloudWatch (DataSource) ---
# Método recomendado: EC2 Instance Profile (dejar vacío si se usa IAM Role)
# Solo completar si NO se usa Instance Profile:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- SMTP (Zoho Mail) ---
GF_SMTP_HOST=smtp.zoho.com:587
GF_SMTP_USER=alertas@tudominio.com
GF_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
GF_SMTP_FROM_ADDRESS=alertas@tudominio.com
GF_SMTP_FROM_NAME=ObservaTI

# --- Discord ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# --- Uptime Kuma ---
UPTIME_KUMA_PORT=3001

# --- General ---
TZ=America/Guatemala
