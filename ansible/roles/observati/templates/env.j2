# ============================================================
# ObservaTI - Environment Variables (generated by Ansible)
# ============================================================
# DO NOT EDIT MANUALLY - managed by Ansible playbook
# ============================================================

# --- Grafana ---
GF_ADMIN_USER={{ grafana_admin_user }}
GF_ADMIN_PASSWORD={{ grafana_admin_password }}
GF_SERVER_ROOT_URL=http://{{ ansible_host }}:3000
GF_SERVER_DOMAIN={{ ansible_host }}

# --- AWS CloudWatch ---
# Credenciales no necesarias: la instancia usa IAM Role (Instance Profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION={{ aws_default_region }}

# --- SMTP (Zoho Mail) ---
GF_SMTP_HOST={{ smtp_host }}
GF_SMTP_USER={{ smtp_user | default('') }}
GF_SMTP_PASSWORD={{ smtp_password | default('') }}
GF_SMTP_FROM_ADDRESS={{ smtp_user | default('noreply@localhost') }}
GF_SMTP_FROM_NAME={{ smtp_from_name }}

# --- Discord ---
DISCORD_WEBHOOK_URL={{ discord_webhook_url | default('') }}

# --- Alertas Email ---
GF_ALERT_EMAIL_ADDRESSES={{ smtp_user | default('admin@localhost') }}

# --- Uptime Kuma ---
UPTIME_KUMA_PORT={{ uptime_kuma_port }}

# --- General ---
TZ={{ timezone }}
